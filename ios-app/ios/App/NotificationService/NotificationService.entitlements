<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Wspólny kontener z aplikacją. Rozszerzenie ma własny `UserDefaults`,
	     więc bez tej grupy nie zobaczyłoby ani wybranego języka, ani ustawienia
	     „Bez dźwięku" dla żółtego — a wtedy musiałoby zgadywać z języka telefonu.
	     Ta sama grupa musi być w App.entitlements i przy OBU identyfikatorach
	     aplikacji na koncie Apple (patrz PLAN_IOS.md §10, etap B). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.pl.straznik.app</string>
	</array>
</dict>
</plist>
