# Skopiuj do keystore.properties i uzupełnij własnymi wartościami.
# Ten plik NIE trafia do repozytorium (jest w .gitignore) — hasła zostają u Ciebie.
#
# storeFile: ścieżka do pliku klucza względem android-app/android/
# storePassword / keyPassword: hasła podane przy tworzeniu klucza (keytool)
# keyAlias: nazwa klucza wewnątrz pliku (parametr -alias w keytool)

storeFile=straznik-release.jks
storePassword=TWOJE_HASLO_DO_PLIKU
keyAlias=straznik
keyPassword=TWOJE_HASLO_DO_KLUCZA
