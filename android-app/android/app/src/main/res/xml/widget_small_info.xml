<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: odświeża WidgetRefreshJob (sieć wymagana) i push FCM -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_small"
    android:previewLayout="@layout/widget_small_preview"
    android:previewImage="@drawable/widget_small_preview_img"
    android:description="@string/widget_small_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
