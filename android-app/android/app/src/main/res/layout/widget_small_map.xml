<?xml version="1.0" encoding="utf-8"?>
<!-- Mały widżet 2×2 z mapą pod spodem. Sam tekst na gołym tle wyglądał ubogo
     (uwaga usera 26.09.2026), a mapa Polski z obrysem obserwowanego województwa
     niesie tę samą informację szybciej niż napis. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_map">

    <ImageView
        android:id="@+id/w_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_scrim_top"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="9dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/widget_dot_stale"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/w_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_map_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/widget_loading"
            android:textColor="@color/widget_map_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/w_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="1dp"
            android:baselineAligned="true"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_points_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/widget_map_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/w_pts_label"
                android:layout_marginStart="3dp"
                android:text="@string/widget_pts"
                android:textColor="@color/widget_map_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_scrim_bottom"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp"
        android:text="@string/widget_foot"
        android:textColor="@color/widget_map_muted"
        android:textSize="9sp" />
</FrameLayout>
