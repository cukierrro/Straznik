<?xml version="1.0" encoding="utf-8"?>
<!-- Widżet z mapą (4×2 i 4×3). Mapę rysuje WidgetMap po Canvasie i wstawia jako
     obrazek; panel z lewej jest półprzezroczysty, żeby mapa była pod nim widoczna. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_map">

    <ImageView
        android:id="@+id/w_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/w_panel"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_scrim"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="9dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/w_ptop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_map_muted"
            android:textSize="10.5sp" />

        <LinearLayout
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_dot1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/widget_dot_stale"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/w_name1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_pts1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_sub1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_map_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_dot2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/widget_dot_stale"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/w_name2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_pts2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_map_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/w_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/w_dot3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/widget_dot_stale"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/w_name3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_pts3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="@color/widget_map_text"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_sub3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_map_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_chip"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textColor="@color/widget_map_text"
        android:textSize="10.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/w_near"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_map_text"
            android:textSize="10.5sp" />
        <TextView
            android:id="@+id/w_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_foot"
            android:textColor="@color/widget_map_muted"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
