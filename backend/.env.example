# Skopiuj do .env i uzupełnij. Nie commituj .env do gita.

HOST=0.0.0.0
PORT=8600

# ── ntfy (zalecane na telefon) ───────────────────────────────────────────────
# 1. Zainstaluj aplikację ntfy (Google Play / F-Droid)
# 2. Wymyśl DŁUGI, losowy temat (kto zna nazwę tematu, może czytać i pisać!)
# 3. W aplikacji: Subscribe to topic -> wpisz ten sam temat
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# ── Telegram ─────────────────────────────────────────────────────────────────
# 1. Napisz do @BotFather -> /newbot -> skopiuj token
# 2. Napisz cokolwiek do swojego bota
# 3. Otwórz https://api.telegram.org/bot<TOKEN>/getUpdates -> odczytaj chat.id
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Push (przeglądarka) ──────────────────────────────────────────────────
WEBPUSH_ENABLED=true
VAPID_CONTACT=mailto:noweartykuly@gmail.com

# ── ADS-B ────────────────────────────────────────────────────────────────────
# adsb.lol (domyślne, darmowe, bez klucza) | adsb.fi | adsbx (wymaga klucza)
ADSB_PROVIDER=adsb.lol
# Klucz ADSBexchange (opcjonalnie): https://rapidapi.com/adsbx/api/adsbexchange-com1
# -> Subscribe to Test (darmowy plan) -> skopiuj X-RapidAPI-Key
ADSBX_RAPIDAPI_KEY=

# interwały odpytywania [s]
ADSB_INTERVAL=60
RSS_INTERVAL=60
RCB_INTERVAL=120
PANSA_INTERVAL=300

# ── FCM (push do aplikacji Android; tematy per województwo) ────────────────────
# Wymaga projektu Firebase i klucza konta serwisowego (Project Settings ->
# Service accounts -> Generate new private key). Klucz połóż POZA repo, domyślnie
# w backend/data/fcm-service-account.json (jest w .gitignore). NIE commituj go.
FCM_ENABLED=true
# FCM_CREDENTIALS_PATH=backend/data/fcm-service-account.json

# ── Endpoint testowy /api/test-signal ─────────────────────────────────────────
# Wstrzykuje sygnały do fuzji i wyzwala push do WSZYSTKICH subskrybentów — dlatego
# domyślnie WYŁĄCZONY. Włącz tylko lokalnie do testów.
TEST_SIGNAL_ENABLED=false
